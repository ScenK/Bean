{
  "name": "bean",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run build --filter=@bean/core --filter=@bean/host --filter=@bean/discord --filter=@bean/teams && pnpm --filter @bean/app build && pnpm --filter @bean/app dev",
    "dist:mac": "turbo run build --filter=@bean/core --filter=@bean/host --filter=@bean/discord --filter=@bean/teams && pnpm --filter @bean/app dist:mac",
    "dist:win": "turbo run build --filter=@bean/core --filter=@bean/host && pnpm --filter @bean/app dist:win",
    "pack:core": "turbo run build --filter=@bean/host --filter=@bean/discord --filter=@bean/teams && node scripts/pack-bean-core.mjs",
    "release": "pnpm --dir packages/app version",
    "worktree:create": "bash scripts/worktree.sh create",
    "worktree:remove": "bash scripts/worktree.sh remove",
    "upgrade:outdated": "node scripts/outdated-report.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
