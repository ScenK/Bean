{
  "name": "@bean/core",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./persona": {
      "types": "./dist/persona.d.ts",
      "default": "./dist/persona.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./routine-graph": {
      "types": "./dist/routine-graph.d.ts",
      "default": "./dist/routine-graph.js"
    },
    "./routine-examples": {
      "types": "./dist/routine-examples.d.ts",
      "default": "./dist/routine-examples.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./frontmatter": {
      "types": "./dist/frontmatter.d.ts",
      "default": "./dist/frontmatter.js"
    },
    "./cron": {
      "types": "./dist/cron.d.ts",
      "default": "./dist/cron.js"
    },
    "./watch-window": {
      "types": "./dist/watch-window.d.ts",
      "default": "./dist/watch-window.js"
    },
    "./project-select": {
      "types": "./dist/project-select.d.ts",
      "default": "./dist/project-select.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openai": "^7.45.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
