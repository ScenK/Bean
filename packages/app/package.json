{
  "name": "@bean/app",
  "version": "1.261110.2",
  "description": "A desktop companion that chats, remembers, and — with your confirmation — gets things done.",
  "author": "Scen.K",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron dist/main.js",
    "dist:mac": "pnpm build && electron-builder --mac",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep @ci",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postversion": "git push --follow-tags",
    "postinstall": "node scripts/pty-spawn-helper.mjs"
  },
  "build": {
    "appId": "dev.scenk.bean",
    "productName": "Bean",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../.bean",
        "to": "builtin"
      },
      {
        "from": "../discord/dist",
        "to": "chatops/discord",
        "filter": [
          "server.js",
          "server.js.map"
        ]
      },
      {
        "from": "../teams/dist",
        "to": "chatops/teams",
        "filter": [
          "server.js",
          "server.js.map"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "afterPack": "scripts/pty-spawn-helper.mjs",
    "afterSign": "scripts/after-sign.mjs"
  },
  "devDependencies": {
    "@bean/core": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "marked": "^18.1.3",
    "preact": "^11.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  }
}
