{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.2.0",
  "id": "1ba7fc48-d369-4d8a-b643-94c56555faee",
  "packageName": "com.bean.teamsbot",
  "developer": {
    "name": "Scen.K",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "Bean",
    "full": "Bean — Digital Team Assistant"
  },
  "description": {
    "short": "Bean, your team's digital assistant.",
    "full": "Bean is a digital team member that works alongside you in Microsoft Teams — message it directly in a 1:1 chat or @mention it in a group. Like a capable secretary, Bean handles requests conversationally, proposes and runs delegated tasks with confirm-first Adaptive Cards, and reports the results back to the thread."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#5B4B8A",
  "bots": [
    {
      "botId": "<APP_ID>",
      "scopes": [
        "personal",
        "groupChat",
        "team"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "supportsTargetedMessages": true,
      "commandLists": [
        {
          "scopes": [
            "personal",
            "team",
            "groupChat"
          ],
          "triggers": [
            "slash",
            "mention"
          ],
          "commands": [
            {
              "title": "stop",
              "description": "stop — stop the running task or live session"
            },
            {
              "title": "cancel",
              "description": "cancel — drop the pending proposal"
            },
            {
              "title": "new",
              "description": "new — start a fresh conversation"
            },
            {
              "title": "whoami",
              "description": "whoami — show your Bean role"
            },
            {
              "title": "live-session",
              "description": "live-session <prompt> — start an interactive coding session (owner only)"
            }
          ]
        },
        {
          "scopes": [
            "team",
            "groupChat"
          ],
          "triggers": [
            "slash",
            "mention"
          ],
          "commands": [
            {
              "title": "drivers",
              "description": "drivers — who may steer the live session"
            },
            {
              "title": "admins",
              "description": "admins — list this chat's admins"
            },
            {
              "title": "add-admin",
              "description": "add-admin @name — owner only"
            },
            {
              "title": "remove-admin",
              "description": "remove-admin @name — owner only"
            }
          ]
        },
        {
          "scopes": [
            "personal"
          ],
          "triggers": [
            "slash",
            "mention"
          ],
          "commands": [
            {
              "title": "routines",
              "description": "routines — list routines (owner only)"
            },
            {
              "title": "enable",
              "description": "enable <routine name> — owner only"
            },
            {
              "title": "disable",
              "description": "disable <routine name> — owner only"
            }
          ]
        }
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [],
  "webApplicationInfo": {
    "id": "<APP_ID>",
    "resource": "https://RscBasedStoreApp"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "ChannelMessage.Read.Group",
          "type": "Application"
        },
        {
          "name": "ChatMessage.Read.Chat",
          "type": "Application"
        }
      ]
    }
  }
}
